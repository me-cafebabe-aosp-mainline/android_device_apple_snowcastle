# System
/dev/block/loop0 /system ext4 noatime,ro first_stage_mount,wait

# Userdata
tmpfs /data tmpfs rw,size=1024M,nodev,noatime,nosuid latemount

# Vendor
/dev/block/loop1 /vendor ext4 noatime,ro first_stage_mount,wait
